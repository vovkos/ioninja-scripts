//..............................................................................
//
// Common surface of channels to a remote ioninja-hwc (SSH, rendezvous)
//
// incoming hwc messages go to the current sink -- normally the session; the
// FPGA uploader takes the sink over for the duration of its requests
//
// outgoing messages are queued and written as fast as the transport's buffer
// allows -- the derived class calls flushWriteBuffer() when it can take more
//

import "io_HwcProto.jnc"
import "std_Buffer.jnc"

namespace iox {

//! \addtogroup common-io
//! @{

//..............................................................................

class HwcSink {
	abstract void onMsg(io.HwcMsgHdr const* hdr);

	abstract void onOobData(
		void const* p,
		size_t size
	);
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

class HwcBase {
protected:
	std.Buffer m_writeBuffer; // packed messages not yet accepted by the transport

public:
	HwcSink* m_sink;
	readonly std.Buffer m_msgBuffer; // not yet complete message
	readonly size_t m_msgCount;      // since the last connect

public:
	construct(HwcSink* sink) {
		m_sink = sink;
	}

	bool errorcode writeMsg(
		io.HwcMsgCode code,
		void const* p = null,
		size_t size = 0
	);

protected:
	abstract size_t errorcode writeTransport(
		void const* p,
		size_t size
	);

	bool errorcode flushWriteBuffer(); // as much as the transport takes; call again when it can take more

	void resetBuffers(); // on connect
	void decode(         // on incoming data
		void const* p,
		size_t size
	);
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

bool errorcode HwcBase.writeMsg(
	io.HwcMsgCode code,
	void const* p,
	size_t size
) {
	io.HwcMsgHdr hdr;
	hdr.m_stx = 0x02;
	hdr.m_code = code;
	hdr.m_dataSize = size;
	m_writeBuffer.append(&hdr, sizeof(hdr));
	m_writeBuffer.append(p, size);
	return flushWriteBuffer();
}

bool errorcode HwcBase.flushWriteBuffer() {
	if (!m_writeBuffer.m_size)
		return true;

	size_t size = writeTransport(m_writeBuffer.m_p, m_writeBuffer.m_size);
	m_writeBuffer.remove(0, size); // the rest goes on the next flush
	return true;
}

void HwcBase.resetBuffers() {
	m_writeBuffer.clear();
	m_msgBuffer.clear();
	m_msgCount = 0;
}

void HwcBase.decode(
	void const* p,
	size_t size
) {
	m_msgBuffer.append(p, size);

	while (m_msgBuffer.m_size >= sizeof(io.HwcMsgHdr)) {
		io.HwcMsgHdr const* hdr = (io.HwcMsgHdr const*)m_msgBuffer.m_p;
		if (hdr.m_stx != 0x02) {
			char const* stx = memchr(m_msgBuffer.m_p, 0x02, m_msgBuffer.m_size);
			size_t skipSize = stx ? stx - m_msgBuffer.m_p : m_msgBuffer.m_size;
			m_sink.onOobData(m_msgBuffer.m_p, skipSize);
			m_msgBuffer.remove(0, skipSize);
			if (m_msgBuffer.m_size < sizeof(io.HwcMsgHdr))
				break; // header not buffered yet
		}

		size_t msgSize = sizeof(io.HwcMsgHdr) + hdr->m_dataSize;
		if (m_msgBuffer.m_size < msgSize)
			break; // not fully buffered yet

		m_sink.onMsg(hdr);
		m_msgCount++;
		m_msgBuffer.remove(0, msgSize);
	}
}

//..............................................................................

//! @}

} // namespace iox
