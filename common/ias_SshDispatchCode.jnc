enum SshDispatchCode: uint64_t {
	GetUrl = 0x01dd78016172f100,
	SetUrl,
	GetUserName,
	SetUserName,
	SetPassword,
	SetPasswordNextConnectOnly,
	GetState,
	Connect,
	Disconnect,
	ShowDevicePopup,
}

