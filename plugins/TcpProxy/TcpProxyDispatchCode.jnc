enum TcpProxyDispatchCode: uint64_t {
	GetTargetAddress = 0x01dd7afdfee29000,
	SetTargetAddress,
	GetTargetPort,
	SetTargetPort,
	GetLocalPort,
	SetLocalPort,
	Listen,
	StopListen,
	Disconnect,
	DisconnectAll,
}

