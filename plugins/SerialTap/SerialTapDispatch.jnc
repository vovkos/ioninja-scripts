//..............................................................................
//
// Serial Tap session dispatch interface for IAS
//

import "ias_SerialDispatchBase.jnc"

//..............................................................................

class SerialTapDispatch: ias.SerialDispatchBase<ias.PluginDispatch> {
	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode capture() {
		return dispatch(SerialTapDispatchCode.Capture);
	}

	void stopCapture() {
		dispatch(SerialTapDispatchCode.StopCapture);
	}
}

//..............................................................................
