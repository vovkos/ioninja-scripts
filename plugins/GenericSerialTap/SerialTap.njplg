#...............................................................................
#
#  Generic Serial Tap session plugin
#

[plugin]

name        = "Generic Serial Tap"
description = "Monitor serial communication through a generic dual COM-port tap cable"
page        = plugins/generic-serial-tap.html
help        = user-manual/plugin-generic-serial-tap.html
id          = gen-serial-tap
group       = serial
monitor     = true
log-guid    = 29725452-e64f-4c0e-a871-776277b68572  # serial log
icon        = images/serialmon.png
small-icon  = images/serialmon-16x16.png

session-class     = SerialTapSession
dispatch-class    = GenericSerialTapDispatch
dispatch-variable = g_serialTap

[required-capabilities]

org.jancy.io.serial

[scripts]

SerialTapSession.jnc
GenericSerialTapDispatchCode.jnc

[dispatch-scripts]

GenericSerialTapDispatchCode.jnc
GenericSerialTapDispatch.jnc
