enum WebSocketServerDispatchCode: uint64_t {
	GetLocalPort = 0x01dd7afdfee2c000,
	SetLocalPort,
	GetSecure,
	SetSecure,
	Listen,
	StopListen,
	Disconnect,
	DisconnectAll,
	Ping,
}

