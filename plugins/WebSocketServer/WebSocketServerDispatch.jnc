//..............................................................................
//
// WebSocket Server session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class WebSocketServerDispatch: ias.PluginDispatch {
	property m_localPort {
		uint_t get() {
			return dispatchGet(WebSocketServerDispatchCode.GetLocalPort);
		}

		void set(uint_t value) {
			dispatch(WebSocketServerDispatchCode.SetLocalPort, value);
		}
	}

	property m_isSecure { // wss://
		bool get() {
			return dispatchGet(WebSocketServerDispatchCode.GetSecure);
		}

		void set(bool value) {
			dispatch(WebSocketServerDispatchCode.SetSecure, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode listen() {
		return dispatch(WebSocketServerDispatchCode.Listen);
	}

	bool errorcode listen(uint_t port) {
		dispatch(WebSocketServerDispatchCode.SetLocalPort, port);
		return dispatch(WebSocketServerDispatchCode.Listen);
	}

	void stopListen() {
		dispatch(WebSocketServerDispatchCode.StopListen);
	}

	void disconnect() {
		dispatch(WebSocketServerDispatchCode.Disconnect);
	}

	void disconnectAll() {
		dispatch(WebSocketServerDispatchCode.DisconnectAll);
	}

	void ping() {
		dispatch(WebSocketServerDispatchCode.Ping);
	}
}

//..............................................................................
