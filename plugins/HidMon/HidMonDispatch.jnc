//..............................................................................
//
// HID Monitor session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class HidMonDispatch: ias.PluginDispatch {
	uint_t const property m_deviceVid {
		return dispatchGet(HidMonDispatchCode.GetDeviceVid);
	}

	uint_t const property m_devicePid {
		return dispatchGet(HidMonDispatchCode.GetDevicePid);
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode setDeviceVidPid(
		uint_t vid,
		uint_t pid
	) {
		return dispatch(HidMonDispatchCode.SetDeviceVidPid, (vid << 16) | (pid & 0xffff));
	}

	bool errorcode capture() {
		return dispatch(HidMonDispatchCode.Capture);
	}

	void close() {
		dispatch(HidMonDispatchCode.Close);
	}
}

//..............................................................................
