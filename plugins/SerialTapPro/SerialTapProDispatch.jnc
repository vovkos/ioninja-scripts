//..............................................................................
//
// Serial Tap Pro session dispatch interface for IAS
//

import "ias_SerialDispatchBase.jnc"

//..............................................................................

class SerialTapProDispatch: ias.SerialDispatchBase<ias.PluginDispatch> {
	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode capture() {
		return dispatch(SerialTapProDispatchCode.Capture);
	}

	void stopCapture() {
		dispatch(SerialTapProDispatchCode.StopCapture);
	}
}

//..............................................................................
