#...............................................................................
#
#  Mailslot session plugin
#

[plugin]

name        = Mailslot
description = "Reads from server side of mailslot"
page        = plugins/mailslot.html
help        = user-manual/plugin-mailslot.html
id          = mailslot
monitor     = true
group       = fs
log-guid    = 8383248D-607F-431A-9414-178C23FD9603  # mailslot
icon        = images/mailslot.png
small-icon  = images/mailslot-16x16.png

session-class     = MailslotSession
dispatch-class    = MailslotDispatch
dispatch-variable = g_mailslot
null-packets      = true

[required-capabilities]

org.jancy.io.win.mailslot

[scripts]

MailslotSession.jnc
MailslotDispatchCode.jnc

[dispatch-scripts]

MailslotDispatchCode.jnc
MailslotDispatch.jnc
