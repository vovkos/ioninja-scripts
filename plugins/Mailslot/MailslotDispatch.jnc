//..............................................................................
//
// Mailslot session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class MailslotDispatch: ias.PluginDispatch {
	property m_mailslotName {
		string_t get() {
			return dispatchGet(MailslotDispatchCode.GetMailslotName);
		}

		void set(string_t value) {
			dispatch(MailslotDispatchCode.SetMailslotName, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode open(string_t mailslotName = null) { // null = use m_mailslotName
		return dispatch(MailslotDispatchCode.Open, mailslotName);
	}

	void close() {
		dispatch(MailslotDispatchCode.Close);
	}
}

//..............................................................................
