//..............................................................................
//
// Serial Monitor session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class SerialMonDispatch: ias.PluginDispatch {
	property m_portName {
		string_t get() {
			return dispatchGet(SerialMonDispatchCode.GetPortName);
		}

		void set(string_t value) {
			dispatch(SerialMonDispatchCode.SetPortName, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode capture(string_t portName = null) { // null = use m_portName
		return dispatch(SerialMonDispatchCode.Capture, portName);
	}

	void close() {
		dispatch(SerialMonDispatchCode.Close);
	}
}

//..............................................................................
