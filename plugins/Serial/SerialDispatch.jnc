//..............................................................................
//
// Serial session dispatch interface for IAS
//

import "ias_SerialDispatchBase.jnc"

//..............................................................................

class SerialDispatch: ias.SerialDispatchBase<ias.PluginDispatch> {
	property m_portName {
		string_t get() {
			return dispatchGet(SerialDispatchCode.GetPortName);
		}

		void set(string_t value) {
			dispatch(SerialDispatchCode.SetPortName, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode open(string_t portName = null) { // null = use m_portName
		return dispatch(SerialDispatchCode.Open, portName);
	}

	void close() {
		dispatch(SerialDispatchCode.Close);
	}
}

//..............................................................................
