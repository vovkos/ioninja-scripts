//..............................................................................
//
// Pipe Server session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class PipeServerDispatch: ias.PluginDispatch {
	property m_pipeName {
		string_t get() {
			return dispatchGet(PipeServerDispatchCode.GetPipeName);
		}

		void set(string_t value) {
			dispatch(PipeServerDispatchCode.SetPipeName, value);
		}
	}

	property m_isMessageMode {
		bool get() {
			return dispatchGet(PipeServerDispatchCode.GetMessageMode);
		}

		void set(bool value) {
			dispatch(PipeServerDispatchCode.SetMessageMode, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode listen(string_t pipeName = null) { // null = use m_pipeName
		return dispatch(PipeServerDispatchCode.Listen, pipeName);
	}

	void stopListen() {
		dispatch(PipeServerDispatchCode.StopListen);
	}

	void disconnectAll() {
		dispatch(PipeServerDispatchCode.DisconnectAll);
	}
}

//..............................................................................
