//..............................................................................
//
// Tibbo Modbus Gateway Monitor session dispatch interface for IAS
//

import "ias_PluginDispatch.jnc"

//..............................................................................

class ModbusGatewayMonDispatch: ias.PluginDispatch {
	property m_remoteAddress {
		string_t get() {
			return dispatchGet(ModbusGatewayMonDispatchCode.GetRemoteAddress);
		}

		void set(string_t value) {
			dispatch(ModbusGatewayMonDispatchCode.SetRemoteAddress, value);
		}
	}

	property m_remotePort {
		uint_t get() {
			return dispatchGet(ModbusGatewayMonDispatchCode.GetRemotePort);
		}

		void set(uint_t value) {
			dispatch(ModbusGatewayMonDispatchCode.SetRemotePort, value);
		}
	}

	construct(intptr handle) {
		basetype.construct(handle);
	}

	bool errorcode connect(string_t address = null) { // null = use m_remoteAddress
		return dispatch(ModbusGatewayMonDispatchCode.Connect, address);
	}

	void disconnect() {
		dispatch(ModbusGatewayMonDispatchCode.Disconnect);
	}
}

//..............................................................................
